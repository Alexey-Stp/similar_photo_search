      "comment" : "VoiceOver hint for the Cancel scan button.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Stops the scan. Groups found so far are kept." } }
      }
