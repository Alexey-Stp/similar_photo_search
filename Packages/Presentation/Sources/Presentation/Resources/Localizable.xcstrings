    "onboarding.page1.body" : {
      "comment" : "Onboarding page 1 body: what the app does.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "SimilarPhotos groups near-duplicate shots, like bursts and retakes, and suggests the best one to keep. You decide what gets deleted." } }
      }
    },
    "onboarding.page1.title" : {
      "comment" : "Onboarding page 1 title: what the app does.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Find similar photos" } }
      }
    },
    "onboarding.page2.body" : {
      "comment" : "Onboarding page 2 body: the on-device privacy promise. Must stay accurate: the app has no networking code.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your photos are analysed right on this iPhone. This app does not send your photos or any data about them anywhere, and it works the same in Airplane Mode." } }
      }
    },
    "onboarding.page2.title" : {
      "comment" : "Onboarding page 2 title: the on-device privacy promise.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "100% on your device" } }
      }
    },
    "onboarding.page3.body" : {
      "comment" : "Onboarding page 3 body: explains why full photo access is needed.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "To find similar photos, the app needs to see your library. Full access finds the most. If you share only some photos, results may be incomplete. Nothing is ever deleted without your confirmation." } }
      }
    },
    "onboarding.page3.title" : {
      "comment" : "Onboarding page 3 title: photo access primer.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow photo access" } }
      }
    },
    "permissionDenied.message" : {
      "comment" : "Explains why photo access is needed after it was denied.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "SimilarPhotos needs access to your photos to find duplicates. You can allow access in Settings." } }
      }
    },
