      "comment" : "Scope sheet footer under the session gap picker.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Similar photos are usually taken in a series, minutes apart. A longer pause keeps slow series, such as a sunset, together, but compares more photos. Changing it regroups photos without analyzing them again." } }
      }
    },
    "scope.sessionGap.hint" : {
      "comment" : "VoiceOver hint for the session gap picker. A pause between two neighbouring shots that is longer than the chosen time starts a new series; photos are compared only within a series, which can be longer than this time.",
