      }
    },
    "restricted.message" : {
      "comment" : "Explains that photo access is blocked by parental controls or device management and cannot be changed by the user.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Access to photos is blocked on this device, for example by Screen Time or a management profile. Ask the person who manages this device to allow it." } }
      }
    },
    "restricted.title" : {
      "comment" : "Title shown when photo access is restricted.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Photo access is restricted" } }
      }
