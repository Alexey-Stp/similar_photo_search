    "scope.sessionGap.balanced" : {
      "comment" : "Session gap choice: 15 minutes, the default.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Balanced (15 min)" } }
      }
    },
    "scope.sessionGap.footer" : {
      "comment" : "Scope sheet footer under the session gap picker.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Similar photos are usually taken in a series, minutes apart. A longer pause keeps slow series, such as a sunset, together, but compares more photos. Changing it regroups photos without analyzing them again." } }
      }
    },
    "scope.sessionGap.hint" : {
      "comment" : "VoiceOver hint for the session gap picker. A pause between two neighbouring shots that is longer than the chosen time starts a new series; photos are compared only within a series, which can be longer than this time.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A longer pause between two shots starts a new series. Only photos in the same series are compared." } }
      }
    },
    "scope.sessionGap.label" : {
      "comment" : "Scope sheet picker label: the longest pause between two neighbouring shots that keeps them in one series. Not a limit on the time between any two compared photos.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Longest Pause Between Shots" } }
      }
    },
    "scope.sessionGap.relaxed" : {
      "comment" : "Session gap choice: 60 minutes.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Relaxed (60 min)" } }
      }
    },
    "scope.sessionGap.strict" : {
      "comment" : "Session gap choice: 5 minutes.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Strict (5 min)" } }
      }
    },
    "scope.skipScreenshots" : {
      "comment" : "Scope sheet toggle that leaves screenshots out of the scan.",
