// Settings shared by every configuration of the SimilarPhotos app target.

PRODUCT_NAME = SimilarPhotos
PRODUCT_BUNDLE_IDENTIFIER = com.similarphotos.SimilarPhotos
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

SDKROOT = iphoneos
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1

// Swift 6 language mode with complete strict concurrency, zero warnings.
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES

// Info.plist is hand-maintained so CI can lint its usage keys.
INFOPLIST_FILE = SimilarPhotos/Info.plist
GENERATE_INFOPLIST_FILE = NO

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
SWIFT_EMIT_LOC_STRINGS = YES

CODE_SIGN_STYLE = Automatic
ENABLE_USER_SCRIPT_SANDBOXING = YES
ENABLE_PREVIEWS = YES
DEAD_CODE_STRIPPING = YES
